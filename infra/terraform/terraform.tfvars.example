# Copie este arquivo para terraform.tfvars e preencha os valores.
# terraform.tfvars NÃO deve ser commitado — está no .gitignore.

aws_region   = "us-east-1"
project_name = "portfolio"
environment  = "prod"

# Rede
vpc_cidr = "10.0.0.0/16"

# Domínio (precisa existir no Route 53 ou ter o DNS apontado para o ALB)
domain_name         = "meuportfolio.com.br"
acm_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# GitHub (formato: usuario/repositorio)
github_repo = "seu-usuario/PortfolioPessoal"

# Banco de dados
db_instance_class = "db.t4g.micro"
db_username       = "portfolio"

# App Settings
cors_origins       = "https://meuportfolio.com.br"
admin_email        = "bernardorochacba@gmail.com"
admin_name         = "Bernardo Rocha"
jwt_algorithm      = "HS256"
jwt_expire_minutes = 180

# ECS Task Sizes (CPU em units: 256=0.25vCPU, 512=0.5vCPU, 1024=1vCPU)
gateway_cpu     = 256
gateway_memory  = 512
auth_cpu        = 256
auth_memory     = 512
blog_cpu        = 512
blog_memory     = 1024
frontend_cpu    = 256
frontend_memory = 512
